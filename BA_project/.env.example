# Flask
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
ENVIRONMENT=development

# MongoDB Atlas (production)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ba_project
MONGODB_DATABASE=ba_project

# Use MongoDB for logging (set to true in production)
USE_MONGODB_LOGGING=false

# Use MongoDB sample_mflix for movies (21,000+ real movies with posters!)
USE_MONGODB_MOVIES=false

# BentoCloud
BENTOML_ENDPOINT=https://your-bento-deployment.bentoml.ai

# Grafana Cloud Prometheus Remote Write
# Get these from: Grafana Cloud Portal → Prometheus → Send Metrics
GRAFANA_CLOUD_URL=https://prometheus-prod-xx-xxx.grafana.net/api/prom/push
GRAFANA_CLOUD_USER=your-user-id
GRAFANA_CLOUD_API_KEY=your-api-key
